{
  "name": "@zkp2p/mastra-peer-cash",
  "version": "0.1.1",
  "description": "Peer Cash tools for Mastra agents to prepare, track, and unwind Base USDC cash-out orders",
  "keywords": [
    "ai-agent",
    "base",
    "mastra",
    "offramp",
    "peer-cash",
    "tools",
    "usdc",
    "zkp2p"
  ],
  "homepage": "https://github.com/zkp2p/mastra-peer-cash#readme",
  "bugs": {
    "url": "https://github.com/zkp2p/mastra-peer-cash/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkp2p/mastra-peer-cash.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "dev": "tsdown --watch --config tsdown.config.ts",
    "lint": "oxlint src",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci": "bun run lint && bun run format && bun run typecheck && bun run test && bun run build && publint && attw --pack .",
    "prepublishOnly": "bun run ci"
  },
  "dependencies": {
    "@zkp2p/cash": "0.7.0",
    "viem": "2.55.13"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@mastra/core": "1.59.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "publint": "0.3.23",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.59.0 <2.0.0",
    "zod": ">=4.0.0 <5.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
